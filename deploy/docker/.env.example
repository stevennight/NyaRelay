NYARELAY_IMAGE=ghcr.io/your-github-user/nyarelay
NYARELAY_VERSION=v0.1.23
NYARELAY_PUBLIC_URL=https://relay.example.com
# Host path to a 32-byte base64-encoded controller secrets key, kept outside the repository.
NYARELAY_SECRETS_KEY_FILE=/etc/nyarelay/controller-secrets.key
NYARELAY_BIND_ADDR=127.0.0.1
NYARELAY_HOST_PORT=8080
# Leave proxy header trust disabled unless the controller is reachable through a known proxy network.
# NYARELAY_TRUST_PROXY_HEADERS=true
# NYARELAY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# History cleanup durations use Go duration syntax. Set a retention to 0s to disable it.
NYARELAY_METRICS_RETENTION=168h
NYARELAY_AUDIT_RETENTION=2160h
NYARELAY_CLEANUP_INTERVAL=1h
# Candidate failure cooldown; whole-second Go duration, default 5s.
NYARELAY_FAILURE_COOLDOWN=5s
